---
const { url, title, description, pubDate, tags } = Astro.props;
---

<li style="list-style-type: none;">
  <a href={url} style="text-decoration: none;">{title}</a>
  <p>{description}</p>
  <p>
    {
      new Date(pubDate).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
      })
    }
  </p>

  <p>
    {
      tags.map((tag: string) => (
        <button>
          <a href="#">{tag} </a>
        </button>
      ))
    }
  </p>
  <a href={url} style="text-decoration: none; color: lightblue">Read more...</a>
</li>
